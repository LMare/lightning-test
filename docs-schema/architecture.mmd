graph TD
    subgraph "Frontend Layer"
        FE["🌐 Frontend<br/>Port: 8000<br/>HTML/CSS/JS"]
    end
    
    subgraph "Backend Layer"
        BE["⚙️ Backend<br/>Go Application"]
        LH["lightningHandler<br/>Node Management"]
        RH["routerHandler<br/>Payment Routes"]
        UH["userHandler<br/>Users"]
        SH["streamEventHandler<br/>Real-time Events"]
    end
    
    subgraph "Lightning Network"
        LND0["⚡ LND-0<br/>Port 9735 P2P<br/>Port 10009 gRPC<br/>Volume: lnd-0_data"]
