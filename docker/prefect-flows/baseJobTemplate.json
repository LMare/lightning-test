{
  "variables": {
    "type": "object",
    "properties": {
      "api_url": {
        "type": "string",
        "default": "http://prefect-server.data.svc.cluster.local:4200/api"
      },
      "image": {
        "type": "string",
        "default": "LMare/prefect-flows:VERSION"
      }
    }
  },
  "job_configuration": {
    "job_manifest": {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "spec": {
        "completions": 1,
        "parallelism": 1,
        "backoffLimit": 2,
        "template": {
          "spec": {
            "containers": [
              {
                "name": "prefect-job",
                "image": "LMare/prefect-flows:VERSION",
                "imagePullPolicy": "IfNotPresent",
                "env": [
                  {
                    "name": "PREFECT_API_URL",
                    "value": "http://prefect-server.data.svc.cluster.local:4200/api"
                  },
                  {
                    "name": "PREFECT_LOGGING_LEVEL",
                    "value": "DEBUG"
                  }
                ]
              }
            ],
            "restartPolicy": "Never"
          }
        }
      }
    }
  },
  "pull_steps": []
}